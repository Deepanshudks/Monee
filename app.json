{
  "expo": {
    "name": "Monee",
    "slug": "monee",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "monee",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/Monee.png",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99e51843-0bef-41ca-b9ef-36d8d1407bf3"
      }
    }
  }
}
